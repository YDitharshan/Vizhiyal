# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL (Prisma) ───────────────────────────────────────
# Local dev (no Docker):
DATABASE_URL=postgresql://postgres:root@localhost:5432/vizhiyal
# Docker dev (docker compose up) — swap to this:
# DATABASE_URL=postgresql://vizhiyal:vizhiyal_pass@postgres:5432/vizhiyal

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=vizhiyal_jwt_secret_key_2025_change_in_production
JWT_EXPIRES_IN=7d

# ── Frontend origin (CORS) ────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── ML recommender service ────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
